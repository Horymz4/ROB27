<robot name="simple_robot">
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.3 0.3 0.3"/>
            </geometry>
        </visual>
    </link>
    <joint name="joint0" type="revolute">
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="cylinder1"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5707963" upper="1.5707963" effort="10" velocity="1"/>
    </joint>
    <link name="cylinder1">
        <visual>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.5"/>
            </geometry>
        </visual>
    </link>
    <joint name="joint_fixed0" type="fixed">
        <origin xyz="0 0 0.5" rpy="0 0 0"/>
        <parent link="cylinder1"/>
        <child link="sphere1"/>
    </joint>
    <link name="sphere1">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.06"/>
            </geometry>
        </visual>
    </link>
    <joint name="joint1" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="sphere1"/>
        <child link="cylinder2"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.5707963" upper="1.5707963" effort="10" velocity="1"/>
    </joint>
    <link name="cylinder2">
        <visual>
            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.25"/>
            </geometry>
        </visual>
    </link>
    <joint name="joint2" type="revolute">
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <parent link="cylinder2"/>
        <child link="cylinder3"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5707963" upper="1.5707963" effort="10" velocity="1"/>
    </joint>
    <link name="cylinder3">
        <visual>
            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.25"/>
            </geometry>
        </visual>
    </link>
    <joint name="joint_fixed1" type="fixed">
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <parent link="cylinder3"/>
        <child link="sphere2"/>
    </joint>
    <link name="sphere2">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.06"/>
            </geometry>
        </visual>
    </link>
    <joint name="joint3" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="sphere2"/>
        <child link="cylinder4"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.5707963" upper="1.5707963" effort="10" velocity="1"/>
    </joint>
    <link name="cylinder4">
        <visual>
            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.25"/>
            </geometry>
        </visual>
    </link>
    <joint name="joint_fixed2" type="fixed">
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <parent link="cylinder4"/>
        <child link="end_effector"/>
    </joint>
    <link name="end_effector">
    </link>

</robot>
